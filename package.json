{
  "name": "openridr",
  "private": true,
  "license": "MIT",
  "version": "0.3.0-alpha.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && cargo check --workspace --all-targets",
    "hooks": "git config core.hooksPath .githooks",
    "test:unit": "bun test tests/unit",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "host:http": "OPENRIDR_HOME=${OPENRIDR_HOME:-$PWD/.scratch/host-home} cargo run -p openridr-host-http -- --port 4317",
    "app:install": "sh scripts/install-app.sh",
    "vendor:netcoredbg": "sh scripts/vendor-netcoredbg.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.1",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
