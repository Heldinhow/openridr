#!/bin/sh
# Opens a solution, project or folder in OpenRidr through LaunchServices (macOS).
# Usage: openridr <path>. Installs nothing; see docs/install-app.md.
# OPENRIDR_APP overrides the app (e.g. a debug bundle path).
set -eu

if [ "$#" -ne 1 ]; then
  echo "usage: openridr <path-to-.sln|.slnx|.csproj|folder>" >&2
  exit 2
fi

if [ ! -e "$1" ]; then
  echo "openridr: path does not exist: $1" >&2
  exit 1
fi

if [ ! -d "$1" ]; then
  lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$lower" in
    *.sln | *.slnx | *.csproj) ;;
    *)
      echo "openridr: not a .sln, .slnx or .csproj: $1" >&2
      echo "openridr: open a .sln, a .slnx, a .csproj or a directory that contains one." >&2
      exit 2
      ;;
  esac
fi

bundle=${OPENRIDR_APP:-OpenRidr}
echo "openridr: opening $bundle" >&2
exec open -a "$bundle" "$1"
