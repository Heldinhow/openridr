{
  "profiles": {
    "http": {
      "commandName": "Project",
      "applicationUrl": "http://localhost:5083",
      "environmentVariables": { "PROFILE_ENV": "http" },
      "commandLineArgs": "--message \"hello world\"",
      "workingDirectory": "."
    },
    "https": {
      "commandName": "Project",
      "applicationUrl": "https://localhost:7259;http://localhost:5083",
      "environmentVariables": { "PROFILE_ENV": "https" }
    },
    "expand": {
      "commandName": "Project",
      "applicationUrl": "http://localhost:5084/?home=%HOME%",
      "environmentVariables": { "PROFILE_ENV": "%HOME%", "EXPANDED": "$(HOME)" },
      "commandLineArgs": "%HOME% $(HOME)"
    },
    "browser": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "/page",
      "applicationUrl": "http://localhost:5090",
      "environmentVariables": { "PROFILE_ENV": "browser" },
      "commandLineArgs": "--listen"
    },
    "browser-off": {
      "commandName": "Project",
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5091",
      "commandLineArgs": "--listen"
    },
    "browser-bad": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "file:///etc/passwd"
    },
    "IIS Express": { "commandName": "IISExpress" }
  }
}
