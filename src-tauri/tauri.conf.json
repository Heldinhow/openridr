{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRidr",
  "version": "0.3.0-alpha.11",
  "identifier": "com.openridr.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build && sh \"$(git rev-parse --show-toplevel)/scripts/vendor-netcoredbg.sh\" && sh \"$(git rev-parse --show-toplevel)/scripts/vendor-analysis.sh\"",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenRidr",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["sln"],
        "name": "Solution",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "text/plain",
        "exportedType": {
          "identifier": "com.openridr.solution",
          "conformsTo": ["public.plain-text"]
        }
      },
      {
        "ext": ["slnx"],
        "name": "Solution (XML)",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "text/xml",
        "exportedType": {
          "identifier": "com.openridr.solution-xml",
          "conformsTo": ["public.xml"]
        }
      },
      {
        "ext": ["csproj"],
        "name": "C# Project",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "text/xml",
        "exportedType": {
          "identifier": "com.openridr.csproj",
          "conformsTo": ["public.xml"]
        }
      },
      {
        "ext": [],
        "name": "Folder",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": ["public.folder"]
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "resources/netcoredbg/": "netcoredbg/",
      "resources/csharp-ls/": "csharp-ls/",
      "resources/dotnet/": "dotnet/",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    }
  }
}
