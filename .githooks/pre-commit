#!/bin/sh
# Enable once per clone with: bun run hooks
#
# Checks only what this commit touches (docs/SPEC-PRECOMMIT-PROPORTIONAL.md): documentation runs
# nothing, TypeScript runs `tsc --noEmit`, Rust runs `cargo check --workspace --all-targets`, and a path
# that is neither runs `tsc`. `bun run check` stays the full check for manual use and for the CI.
#
# Known limit: `cargo check --workspace --all-targets` does not reach `src-tauri` (separate workspace).
set -eu

# The paths of this commit, not of the work tree: with `git commit --only` (scripts/commit-only.sh) git
# points GIT_INDEX_FILE at a temporary index, so this lists only the paths given to the commit. An amend
# that only changes the message lists nothing. `core.quotePath=false` keeps a non-ASCII name raw instead
# of `"crates/a\303\247..."` (which would not match the Rust patterns); `--no-renames` lists both sides of
# a move, so moving a `.rs` out of `crates/` still runs `cargo check`.
if ! staged=$(git -c core.quotePath=false diff --cached --name-only --no-renames); then
  echo 'pre-commit: git diff --cached falhou, rodando o check completo' >&2
  exec bun run check
fi

ts=0
rust=0
for path in $staged; do
  case "$path" in
    '"'*) ts=1; rust=1 ;; # git quoted it (tab, quote, newline in the name): classify nothing, check both
    *.md | docs/*) ;;
    crates/* | src-tauri/* | Cargo.toml | Cargo.lock | rust-toolchain*) rust=1 ;;
    *) ts=1 ;;
  esac
done

if [ "$ts" -eq 0 ] && [ "$rust" -eq 0 ]; then
  echo 'pre-commit: nada a checar'
  exit 0
fi

# A node_modules without the binary gives the same `command not found`; failing here says what to do.
if [ "$ts" -eq 1 ] && [ ! -x node_modules/.bin/tsc ]; then
  echo 'pre-commit: node_modules/.bin/tsc não existe, rode bun install' >&2
  exit 1
fi

if [ "$ts" -eq 1 ]; then
  echo 'pre-commit: tsc --noEmit'
  bun run tsc --noEmit
fi

if [ "$rust" -eq 1 ]; then
  echo 'pre-commit: cargo check --workspace --all-targets'
  cargo check --workspace --all-targets
fi
